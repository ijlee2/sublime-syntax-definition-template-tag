%YAML 1.2
---
name: Glimmer TS
scope: source.gts
version: 2

extends:
  - Packages/JavaScript/TypeScript.sublime-syntax

file_extensions:
  - gts

contexts:
  # Template used as a value
  #   <template>...</template>
  #   const Hello = <template>...</template>;
  #   await render(<template>...</template>);
  expression-begin:
    - meta_prepend: true
    - include: template-tag

  # Template inside a class body
  #   class Hello extends Component {
  #     <template>...</template>
  #   }
  class-body-contents:
    - meta_prepend: true
    - include: template-tag

  template-tag:
    - match: <template>
      scope: punctuation.definition.tag.begin.js
      embed: scope:text.html.handlebars
      embed_scope: source.gts.content
      escape: </template>
      escape_captures:
        0: punctuation.definition.tag.end.js
