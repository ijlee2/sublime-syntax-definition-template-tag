{
  "name": "sublime-syntax-definition-template-tag",
  "version": "4.0.1",
  "private": true,
  "description": "Provides syntax highlighting for *.{gjs,gts} files in Sublime Text",
  "keywords": [
    "emberjs",
    "gjs",
    "gts",
    "language syntax",
    "sublime text",
    "template tag"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ijlee2/sublime-syntax-definition-template-tag.git"
  },
  "license": "MIT",
  "author": "Isaac J. Lee",
  "type": "module",
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "prettier . --cache --check",
    "lint:fix": "prettier . --cache --write",
    "release:prepare": "changeset version",
    "release:publish": "node ./scripts/update-branches.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@ijlee2-frontend-configs/changesets": "^3.0.2",
    "@ijlee2-frontend-configs/prettier": "^3.4.0",
    "prettier": "^3.9.8"
  },
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": "22.* || >= 24"
  }
}
